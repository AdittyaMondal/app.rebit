# ---- project-specific (not upstream) ----

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.bak
*.old
*.orig
*.save

# Laravel runtime
/storage/pail
/storage/logs/*.log
.env.*.local

# Working copies + DB dumps (PII, password hashes, live tokens,
# and queue deserialization payloads in failed_jobs). Never commit.
/dev
/real
*.sql
*.sql.gz
*.dump

# Tooling
/.graphifyignore
/graphify-out
prod.env

# Capacitor / native.
#
# android/ itself IS tracked -- the manifest and Gradle files are hand-edited --
# and Capacitor ships its own android/.gitignore covering build output, .gradle,
# local.properties and the assets copied by `cap sync`. Only the entries their
# template leaves commented out are repeated here, because losing a keystore
# means losing the ability to update a published app.
/public/native
/android/keystore.properties
/android/app/google-services.json
/android/app/*.jks
/android/app/*.keystore
*.p8
*.mobileprovision
/storage/app/private/*.json
