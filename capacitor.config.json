{
    "appId": "com.rebit.app",
    "appName": "REBIT",
    "webDir": "public/native",
    "appendUserAgent": "RebitApp/1.0",
    "server": {
        "androidScheme": "https"
    },
    "android": {
        "allowMixedContent": false
    },
    "plugins": {
        "SplashScreen": {
            "launchAutoHide": false,
            "backgroundColor": "#000000",
            "androidScaleType": "CENTER_CROP",
            "showSpinner": false
        },
        "Keyboard": {
            "resize": "native",
            "resizeOnFullScreen": true
        }
    }
}
